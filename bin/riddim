#!/usr/bin/ruby
# frozen_string_literal: true

require 'json'

require_relative '../lib/riddim/herdr'
require_relative '../lib/riddim/interrupt'
require_relative '../lib/riddim/list'
require_relative '../lib/riddim/ownership'
require_relative '../lib/riddim/profile'
require_relative '../lib/riddim/send'
require_relative '../lib/riddim/start'

if %w[agent-state busy-state current-path pane-presence process-state server-state].include?(ARGV.first)
  verb = ARGV.first
  unless ARGV.length == 2
    warn "Usage: riddim #{verb} <name>"
    exit 2
  end

  name = ARGV[1]
  unless name.match?(Riddim::Ownership::NAME_PATTERN)
    warn 'riddim: name must match [a-z][a-z0-9_-]{0,31}'
    exit 2
  end

  begin
    snapshot = Riddim::Ownership::Endpoint.resolve_snapshot(name)
    endpoint = snapshot.first
    state = case verb
            when 'agent-state' then Riddim::Herdr.agent_state(endpoint.pane_id, session: endpoint.session)
            when 'busy-state' then Riddim::Herdr.busy_state(endpoint.pane_id, session: endpoint.session)
            when 'current-path' then Riddim::Herdr.current_path(endpoint.pane_id, session: endpoint.session)
            when 'process-state' then Riddim::Herdr.pi_process_state(endpoint.pane_id, session: endpoint.session)
            when 'server-state' then Riddim::Herdr.server_running_state(session: endpoint.session)
            else Riddim::Herdr.pane_presence_state(endpoint.pane_id, session: endpoint.session)
            end
    changed_state = %w[agent-state process-state].include?(verb) ? 'unreadable' : 'unknown'
    puts(Riddim::Ownership::Endpoint.unchanged?(name, snapshot) ? state : changed_state)
  rescue Riddim::Ownership::Error => e
    warn "riddim: #{e.message}"
    exit 1
  end
  exit
end

if ARGV.first == 'list'
  unless ARGV == ['list'] || ARGV == %w[list --json]
    warn 'Usage: riddim list [--json]'
    exit 2
  end

  begin
    snapshot = Riddim::List.snapshot
    if ARGV.last == '--json'
      puts JSON.generate(snapshot)
    else
      snapshot.fetch(:records).each { |row| puts "#{row.fetch(:name)}\t#{row.fetch(:session)}\t#{row.fetch(:pane_id)}" }
    end
  rescue Riddim::Ownership::Error, SystemCallError => e
    warn "riddim: #{e.message}"
    exit 1
  end
  exit
end

if ARGV.first == 'send'
  # Firstmate has no synchronous turn-wait send, so Riddim does not carry
  # one. A leading --wait is rejected before Herdr is ever invoked, so it
  # cannot be misparsed as a name; a later --wait stays message text.
  if ARGV[1] == '--wait'
    warn 'riddim: send --wait is unsupported; use riddim send <name> <message...>'
    exit 2
  end

  rest = ARGV.drop(1)
  unless rest.length >= 2
    warn 'Usage: riddim send <name> <message...>'
    exit 2
  end

  name = rest[0]
  unless name.match?(Riddim::Ownership::NAME_PATTERN)
    warn 'riddim: name must match [a-z][a-z0-9_-]{0,31}'
    exit 2
  end

  message = rest.drop(1).join(' ')
  if message.strip.empty?
    warn 'riddim: message must not be blank'
    exit 2
  end

  begin
    # Resolve once without creating a lock for a missing record, then acquire
    # the per-name lock and re-resolve while holding it. The second snapshot is
    # the routing authority, and the lock stays held until Herdr returns, so a
    # cooperating lifecycle writer cannot rebind the name during delivery.
    result = Riddim::Send.run(name, message)
    if result.respond_to?(:success?) && !result.success?
      warn 'riddim: prompt delivery is unconfirmed; inspect the pane before retrying'
      Riddim::Herdr.terminate_like(Riddim::Herdr::CommandFailed.new('', '', result)) if result.signaled?
      exit 3
    end
  rescue Riddim::Ownership::Error, SystemCallError => e
    warn "riddim: #{e.message}"
    exit 1
  end
  exit
end

if ARGV.first == 'interrupt'
  unless ARGV.length == 2
    warn 'Usage: riddim interrupt <name>'
    exit 2
  end

  name = ARGV[1]
  unless name.match?(Riddim::Ownership::NAME_PATTERN)
    warn 'riddim: name must match [a-z][a-z0-9_-]{0,31}'
    exit 2
  end

  begin
    pane = Riddim::Interrupt.run(name)
  rescue Riddim::Ownership::Error, SystemCallError => e
    warn "riddim: #{e.message}"
    exit 1
  rescue Riddim::Herdr::CommandFailed => e
    $stdout.write(e.stdout)
    $stderr.write(e.stderr)
    Riddim::Herdr.terminate_like(e)
  rescue Riddim::Herdr::InvalidResponse => e
    warn "riddim: invalid Herdr agent JSON: #{e.message}"
    exit 1
  rescue Riddim::Herdr::InterruptUnverified => e
    key = Riddim::Herdr::INTERRUPT_KEY
    warn "riddim: #{key} may have been delivered to pane #{e.pane_id}, but the re-read could not " \
         "confirm Herdr still registers that pane as a Pi agent: #{e.message}"
    warn 'riddim: do not retry blindly; inspect the agent with riddim status or riddim peek first'
    exit 1
  end

  puts "interrupt delivered to pane #{pane} (Pi process checked before and after; cancellation unconfirmed)"
  exit
end

if ARGV.first == 'status'
  unless ARGV.length == 2
    warn 'Usage: riddim status <name>'
    exit 2
  end

  name = ARGV[1]
  unless name.match?(Riddim::Ownership::NAME_PATTERN)
    warn 'riddim: name must match [a-z][a-z0-9_-]{0,31}'
    exit 2
  end

  begin
    endpoint = Riddim::Ownership::Endpoint.resolve(name)
  rescue Riddim::Ownership::Error => e
    warn "riddim: #{e.message}"
    exit 1
  end

  begin
    puts Riddim::Herdr.agent(endpoint.pane_id, session: endpoint.session).fetch('agent_status')
  rescue Riddim::Herdr::CommandFailed => e
    $stdout.write(e.stdout)
    $stderr.write(e.stderr)
    Riddim::Herdr.terminate_like(e)
  rescue Riddim::Herdr::InvalidResponse => e
    warn "riddim: invalid Herdr agent JSON: #{e.message}"
    exit 1
  end
  exit
end

if ARGV.first == 'peek'
  unless (2..3).cover?(ARGV.length)
    warn 'Usage: riddim peek <name> [lines]'
    exit 2
  end

  name = ARGV[1]
  unless name.match?(Riddim::Ownership::NAME_PATTERN)
    warn 'riddim: name must match [a-z][a-z0-9_-]{0,31}'
    exit 2
  end

  lines = ARGV[2] || '40'
  unless lines.match?(/\A[1-9]\d*\z/)
    warn 'riddim: lines must be a positive integer'
    exit 2
  end

  # The endpoint ownership record is the routing authority: it is resolved
  # and validated first, failing closed before Herdr is touched at all, and
  # the capture targets the exact pane and session the record binds - never
  # an ambient or inferred target.
  begin
    endpoint = Riddim::Ownership::Endpoint.resolve(name)
  rescue Riddim::Ownership::Error => e
    warn "riddim: #{e.message}"
    exit 1
  end

  begin
    print Riddim::Herdr.pane_tail(session: endpoint.session, pane_id: endpoint.pane_id, lines: lines.to_i)
  rescue Riddim::Herdr::CommandFailed => e
    $stdout.write(e.stdout)
    $stderr.write(e.stderr)
    Riddim::Herdr.terminate_like(e)
  end
  exit
end

if ARGV.first == 'start'
  unless ARGV.length == 2
    warn 'Usage: riddim start <name>'
    exit 2
  end

  name = ARGV[1]
  unless name.match?(/\A[a-z][a-z0-9_-]{0,31}\z/)
    warn 'riddim: name must match [a-z][a-z0-9_-]{0,31}'
    exit 2
  end

  config_dir = ENV.fetch('RIDDIM_CONFIG_DIR', nil)
  config_dir = File.expand_path('../config', __dir__) if config_dir.nil? || config_dir.empty?

  begin
    profile = Riddim::AgentProfile.load(config_dir: config_dir)
  rescue Riddim::AgentProfile::Error => e
    warn "riddim: #{e.message}"
    exit 1
  end

  # Firstmate's spawn sequence, reduced to what Riddim owns: the per-name
  # record lock from duplicate preflight through launch result, duplicate
  # refusal before Herdr is touched at all, then create the exact endpoint,
  # publish the authoritative record, and start the agent.
  Riddim::Start.run(name, profile)
  exit
end

puts <<~HELP
  Usage: riddim <command>

  Commands:
    agent-state <name>          Inspect recorded Pi process (alive/dead/missing/unreadable)
    busy-state <name>           Observe Pi activity (busy/idle/unknown; not completion)
    current-path <name>         Read the exact pane's foreground cwd (or unknown)
    pane-presence <name>        Read exact pane presence (present/gone/unknown)
    process-state <name>        Inspect Pi/shell process evidence (pi/shell/unreadable)
    server-state <name>         Read the recorded session's server state (running/stopped/unknown)
    list [--json]               List recorded agents and exact endpoints (not liveness)
    peek <name> [lines]         Show recent output from a started agent's recorded pane
    interrupt <name>            Interrupt a started Pi agent with one Escape
    send <name> <message...>    Prompt a started agent's recorded pane
    start <name>                Start a background Pi agent
    status <name>               Show a started agent's registered Herdr status
HELP
