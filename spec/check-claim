#!/bin/sh
set -eu

spec_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
jar="$HOME/.local/share/tlaplus/v1.7.4/tla2tools.jar"
java_version='java@temurin-21.0.12+8.0.LTS'

test -f "$jar" || { printf 'Missing %s (see spec/README.md)\n' "$jar" >&2; exit 1; }
command -v mise >/dev/null || { printf 'Missing mise (see spec/README.md)\n' >&2; exit 1; }

tmp=$(mktemp -d "${TMPDIR:-/tmp}/riddim-claim.XXXXXX")
trap 'rm -r -- "$tmp"' EXIT
cp "$spec_dir/ClaimOneName.tla" "$spec_dir/ClaimOneName.cfg" "$tmp/"

printf '1. Checking the original model...\n'
if (cd "$tmp" && mise exec "$java_version" -- java -cp "$jar" tlc2.TLC -workers 1 ClaimOneName.tla > original.log 2>&1); then
  grep -E 'Model checking completed|No error has been found|distinct states found' "$tmp/original.log"
else
  printf 'Original model failed:\n' >&2
  grep -E 'Error:|Invariant|Parsing file' "$tmp/original.log" >&2 || true
  exit 1
fi

ruby -e 'path=ARGV.fetch(0); source=File.read(path); guard=%q{if sawEmpty /\ recordOwner = "none" then}; abort "guard not found exactly once" unless source.scan(guard).length == 1; File.write(path, source.sub(guard, "if sawEmpty then"))' "$tmp/ClaimOneName.tla"
if ! (cd "$tmp" && mise exec "$java_version" -- java -cp "$jar" pcal.trans ClaimOneName.tla > translator.log 2>&1); then
  printf 'PlusCal translation failed:\n' >&2
  grep -E 'error|Error' "$tmp/translator.log" >&2 || true
  exit 1
fi

printf '\n2. Removing the last-minute check in a temporary copy...\n'
if (cd "$tmp" && mise exec "$java_version" -- java -cp "$jar" tlc2.TLC -workers 1 ClaimOneName.tla > broken.log 2>&1); then
  printf 'The broken model passed unexpectedly.\n' >&2
  exit 1
fi
if ! grep -q 'Invariant NeverTwoPublished is violated' "$tmp/broken.log"; then
  printf 'The broken model failed for an unexpected reason.\n' >&2
  grep -E 'Error:|Parsing file' "$tmp/broken.log" >&2 || true
  exit 1
fi
awk '/Error: Invariant NeverTwoPublished is violated/{show=1} show {print} /states generated/{exit}' "$tmp/broken.log"
printf '\nExpected failure found. The original files were not changed.\n'
